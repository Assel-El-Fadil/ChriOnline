<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Client.Controllers.RegisterController"
            stylesheets="@theme.css"
            styleClass="root"
            prefWidth="550"
            prefHeight="580">


    <center>
        <HBox>
            <!-- Left Branding Pane -->
            <VBox styleClass="auth-brand-sidebar" alignment="CENTER_LEFT" spacing="20" prefWidth="450" HBox.hgrow="SOMETIMES">
                <Label text="ChriOnline" styleClass="auth-brand-title"/>
                <Label text="Join the community. Create an account to unlock exclusive features, manage your orders, and enjoy a seamless shopping experience." styleClass="auth-brand-subtitle" wrapText="true"/>
            </VBox>

            <!-- Right Register Form Pane -->
            <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: white;">
                <VBox styleClass="content-section" spacing="18" maxWidth="450" style="-fx-effect: none; -fx-padding: 40;">
                    
                    <!-- Title -->
                    <VBox spacing="6">
                        <Label text="Create Account" styleClass="section-title" style="-fx-padding: 0; -fx-font-size: 28px;"/>
                        <Label text="Join ChriOnline and start shopping" styleClass="login-welcome-subtitle" style="-fx-font-size: 15px;"/>
                    </VBox>

                    <!-- First name / Last name side by side -->
                    <HBox spacing="12">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="First Name" styleClass="login-field-label"/>
                            <TextField fx:id="firstNameField"
                                       promptText="First name"
                                       styleClass="login-form-field"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Last Name" styleClass="login-field-label"/>
                            <TextField fx:id="lastNameField"
                                       promptText="Last name"
                                       styleClass="login-form-field"/>
                        </VBox>
                    </HBox>

                    <!-- Username field -->
                    <VBox spacing="8">
                        <Label text="Username" styleClass="login-field-label"/>
                        <TextField fx:id="usernameField"
                                   promptText="Choose a username"
                                   styleClass="login-form-field"/>
                    </VBox>

                    <!-- Password field -->
                    <VBox spacing="8">
                        <Label text="Password" styleClass="login-field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField"
                                               promptText="At least 6 characters"
                                               styleClass="login-form-field"/>
                                <TextField fx:id="passwordVisibleField"
                                           promptText="At least 6 characters"
                                           styleClass="login-form-field"
                                           visible="false"/>
                            </StackPane>
                            <Button fx:id="togglePasswordBtn"
                                    text="Show"
                                    onAction="#handleTogglePassword"
                                    styleClass="toggle-password-btn"/>
                        </HBox>
                    </VBox>

                    <!-- Confirm Password field -->
                    <VBox spacing="8">
                        <Label text="Confirm Password" styleClass="login-field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="confirmPasswordField"
                                               promptText="Re-enter your password"
                                               styleClass="login-form-field"/>
                                <TextField fx:id="confirmPasswordVisibleField"
                                           promptText="Re-enter your password"
                                           styleClass="login-form-field"
                                           visible="false"/>
                            </StackPane>
                            <Button fx:id="toggleConfirmPasswordBtn"
                                    text="Show"
                                    onAction="#handleToggleConfirmPassword"
                                    styleClass="toggle-password-btn"/>
                        </HBox>
                    </VBox>

                    <!-- Email field -->
                    <VBox spacing="8">
                        <Label text="Email" styleClass="login-field-label"/>
                        <TextField fx:id="emailField"
                                   promptText="example@email.com"
                                   styleClass="login-form-field"/>
                    </VBox>

                    <!-- Error label -->
                    <Label fx:id="errorLabel"
                           styleClass="login-error-label"
                           visible="false"
                           wrapText="true"/>

                    <!-- Buttons -->
                    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Back to Login"
                                onAction="#handleBackToLogin"
                                styleClass="btn-secondary"/>
                        <Button fx:id="registerButton"
                                text="Register"
                                onAction="#handleRegister"
                                defaultButton="true"
                                styleClass="btn-primary"
                                style="-fx-padding: 10 24;"/>
                    </HBox>
                </VBox>
            </StackPane>
        </HBox>
    </center>
</BorderPane>